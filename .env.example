# Settings for the Nobunaga's Ambition Online server. setup.py writes .env from this file;
# without it, copy this file to .env and fill in the two values marked "required".

# Required: the address players' consoles reach this machine at (LAN address for players at
# home, the internet address otherwise). The world list hands it to the client.
NOBU_PUBLIC_IP=

# Required: the token an OpenLobby admin panel sends (setup makes one at random).
NOBU_ADMIN_TOKEN=

# The world's name in the game's world list (no commas).
NOBU_SERVER_NAME=Nobunaga

# Ports. The connect server's 9070 is fixed in the client; the login and world ports are handed
# to it, so any free ones work. Forward all three (TCP) for players outside your network.
NOBU_LOGIN_PORT=9443
NOBU_WORLD_PORT=9110
#NOBU_CONNSV_PORT=9070

# Accounts: claim = an unknown citizen ID is made with its first password, later logins must
# match it. 1 accepts any password (testing only).
NOBU_AUTH_OPEN=claim

# Players with a different route to this machine (a LAN and the internet) can each be handed
# their own world address: CIDR=address pairs, first match wins, e.g.
#   192.168.0.0/16=192.168.0.10,0.0.0.0/0=203.0.113.7
# This needs the players' real addresses, which Docker Desktop hides: Linux only.
#NOBU_ADVERTISE_MAP=

# Sessions, backups.
NOBU_IDLE_SECS=600
NOBU_BACKUP_KEEP=48
NOBU_BACKUP_SECS=3600

# Gameplay switches (empty = the code's default). NOBU_BATTLE_FIGHT=1 turns battles on, and with
# them the field enemies (NOBU_ENEMIES auto); NOBU_ENEMY_WANDER=1 lets them walk;
# NOBU_ENEMY_AGGRO=1 makes red ones start battles. NOBU_DEBUG_NPC=1 spawns the Guide, and with
# it the Overseer and the tutorial chain. The rest are off switches (0 = off). The modules' own
# docstrings list every setting.
NOBU_DEBUG_NPC=1
NOBU_BATTLE_CHAT=0
NOBU_ENEMIES=auto
NOBU_ENEMY_NIGHT=auto
#NOBU_BATTLE_FIGHT=
#NOBU_ENEMY_WANDER=
#NOBU_ENEMY_AGGRO=
#NOBU_TOWN_SPOTS=
#NOBU_TOWN_GUARDS=
#NOBU_SHOP_VENDORS=
#NOBU_BANK_TOWNS=
#NOBU_CASTLE_NPCS=
#NOBU_REPAIR=
#NOBU_DOCTOR=
#NOBU_TOWN_QUESTS=
#NOBU_FIELD_NPCS=
#NOBU_FERRY_FARE=
#NOBU_ELDER=
#NOBU_CASTLE_GATES=
#NOBU_GUILD_JOB_HALLS=

# Where accounts, characters, logs and the game data are kept on this machine, and where
# `docker compose run --rm extract` looks for the disc image.
#NOBU_STATE=./state
#NOBU_DISCS=./discs

# The secret an OpenLobby panel gave at pairing (setup keeps it here).
#OPENLOBBY_PAIRING=
